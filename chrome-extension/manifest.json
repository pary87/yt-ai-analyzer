{
  "manifest_version": 3,
  "name": "YouTube Video Analyzer",
  "version": "1.0.0",
  "description": "Fetch a YouTube video's English transcript and build copy-and-paste ChatGPT analysis prompts.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open YouTube Video Analyzer",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel"],
  "host_permissions": ["https://www.youtube.com/*"]
}
